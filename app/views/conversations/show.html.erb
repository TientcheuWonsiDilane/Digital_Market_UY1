<% content_for :title, "Messages" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Chat Header -->
  <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="flex items-center gap-4 p-5 border-b border-gray-100">
      <%= link_to conversations_path, class: "text-emerald-600 hover:text-emerald-800 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      <% end %>
      <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-100 to-green-50 border-2 border-emerald-200 flex items-center justify-center">
        <span class="text-lg font-black text-emerald-700"><%= @conversation.other_user(current_user).email.first.upcase %></span>
      </div>
      <div>
        <h2 class="font-bold text-emerald-900"><%= @conversation.other_user(current_user).email %></h2>
        <p class="text-xs text-gray-400">
          <%= @conversation.store.present? ? "Via: #{@conversation.store.name}" : "Conversation directe" %>
        </p>
      </div>
    </div>

    <!-- Messages Area -->
    <div id="messages_<%= @conversation.id %>" class="p-6 space-y-4 max-h-[500px] overflow-y-auto bg-gray-50/50">
      <% if @messages.any? %>
        <% @messages.each do |msg| %>
          <%= render partial: "messages/message", locals: { message: msg, current_user: current_user } %>
        <% end %>
      <% else %>
        <div class="text-center py-12">
          <p class="text-gray-400 font-medium">Aucun message pour le moment.</p>
          <p class="text-sm text-gray-300">Envoyez le premier message !</p>
        </div>
      <% end %>
    </div>

    <!-- Message Input -->
    <div class="p-5 border-t border-gray-100 bg-white">
      <%= form_with model: [@conversation, @message], class: "flex gap-3" do |f| %>
        <%= f.text_area :body, placeholder: "Écrivez votre message...", rows: 1, class: "flex-1 rounded-2xl border border-gray-200 px-5 py-3.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none resize-none transition-all duration-300", oninput: "this.style.height = 'auto'; this.style.height = (this.scrollHeight) + 'px'" %>
        <%= f.button class: "flex-shrink-0 bg-gradient-to-r from-emerald-600 to-green-500 hover:from-emerald-700 hover:to-green-600 text-white p-3.5 rounded-2xl shadow-md hover:shadow-lg transition-all duration-300" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
