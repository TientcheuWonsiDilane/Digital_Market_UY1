<% content_for :title, @item.name %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left Column: Images Gallery -->
    <div class="lg:col-span-7">
      <div class="bg-white rounded-3xl border border-gray-200 overflow-hidden shadow-sm">
        <% if @item.images.attached? %>
          <div class="grid grid-cols-1 gap-2">
            <% @item.images.each do |image| %>
              <div class="bg-gray-50">
                <%= image_tag image, class: "w-full h-96 md:h-[500px] object-contain" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="h-96 flex items-center justify-center bg-gradient-to-br from-emerald-50 to-green-50">
            <div class="text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-20 h-20 text-emerald-300 mx-auto mb-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
              <p class="text-emerald-300 font-semibold">Aucune image</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Details -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <span class="text-xs bg-emerald-50 text-emerald-700 font-bold px-3 py-1.5 rounded-full mb-3 inline-block"><%= @item.category %></span>
        
        <h1 class="text-2xl md:text-3xl font-black text-emerald-900 mb-2"><%= @item.name %></h1>
        
        <p class="text-3xl font-black text-emerald-600 mb-6">
          <%= number_to_currency(@item.price, unit: "FCFA ", precision: 0) %>
        </p>

        <div class="prose prose-sm max-w-none text-gray-600 mb-6">
          <%= @item.description %>
        </div>

        <!-- Seller Info -->
        <div class="border-t border-gray-100 pt-5 mt-5">
          <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-3">Vendeur</h3>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-100 to-green-50 border border-emerald-200 flex items-center justify-center flex-shrink-0">
              <span class="text-lg font-bold text-emerald-700"><%= @item.user.username.first.upcase %></span>
            </div>
            <div>
              <p class="font-bold text-emerald-900"><%= @item.user.username %></p>
              <% if @item.store.present? %>
                <%= link_to @item.store.name, @item.store, class: "text-sm text-emerald-600 hover:text-emerald-800 transition-colors" %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 space-y-3">
          <% if user_signed_in? && @item.user != current_user %>
            <% conversation = Conversation.between(current_user, @item.user).first %>
            <% if conversation %>
              <%= link_to conversation, class: "w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-green-500 text-white font-bold px-6 py-4 rounded-2xl shadow-md hover:shadow-lg hover:from-emerald-700 hover:to-green-600 transition-all duration-300" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                Contacter le vendeur
              <% end %>
            <% else %>
              <%= button_to conversations_path(recipient_id: @item.user_id, store_id: @item.store_id), method: :post, class: "w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-green-500 text-white font-bold px-6 py-4 rounded-2xl shadow-md hover:shadow-lg hover:from-emerald-700 hover:to-green-600 transition-all duration-300" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                Contacter le vendeur
              <% end %>
            <% end %>
          <% end %>

          <% if user_signed_in? && @item.user == current_user %>
            <div class="flex gap-3">
              <%= link_to edit_item_path(@item), class: "flex-1 inline-flex items-center justify-center gap-2 bg-white text-emerald-700 font-bold px-6 py-4 rounded-2xl border-2 border-emerald-200 hover:bg-emerald-50 transition-all duration-300" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                </svg>
                Modifier
              <% end %>
              <%= button_to @item, method: :delete, data: { turbo_confirm: "Êtes-vous sûr?" }, class: "flex-1 inline-flex items-center justify-center gap-2 bg-red-50 text-red-600 font-bold px-6 py-4 rounded-2xl border-2 border-red-200 hover:bg-red-100 transition-all duration-300" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
                Supprimer
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
