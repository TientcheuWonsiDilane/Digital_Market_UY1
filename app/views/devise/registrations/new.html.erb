<div class="w-full min-h-[calc(100vh-64px)] flex items-center justify-center bg-gradient-to-br from-green-50 via-white to-emerald-50/30 p-4 md:p-8 relative overflow-hidden">
  
  <!-- Floating Dollars Background -->
<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="dollar-float df-1 text-emerald-400/25">$</div>
      <div class="dollar-float df-2 text-emerald-400/15">$</div>
      <div class="dollar-float df-3 text-emerald-400/20">$</div>
      <div class="dollar-float df-4 text-emerald-400/18">$</div>
      <div class="dollar-float df-5 text-emerald-400/25">$</div>
      <div class="dollar-float df-6 text-emerald-400/10">$</div>
      <div class="dollar-float df-7 text-emerald-400/20">$</div>
      <div class="dollar-float df-8 text-emerald-400/15" style="left: 60%; animation-duration: 14s; animation-delay: 4s; font-size: 3rem;">$</div>
      <div class="dollar-float df-9 text-emerald-400/12" style="left: 75%; animation-duration: 18s; animation-delay: 7s; font-size: 2rem;">$</div>
      <div class="dollar-float df-10 text-emerald-400/20" style="left: 45%; animation-duration: 12s; animation-delay: 3s; font-size: 2.8rem;">$</div>
    </div>

  <!-- Form Card -->
  <div class="w-full max-w-md bg-white rounded-3xl border border-emerald-100 p-8 md:p-10 shadow-xl relative z-10">
    
    <!-- Logo & Title -->
    <div class="flex flex-col items-center mb-8">
      <a href="/" class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-600 to-green-400 flex items-center justify-center shadow-md mb-3 hover:scale-105 transition-transform duration-300">
        <span class="text-white font-black text-xl">DM</span>
      </a>
      <h2 class="text-3xl font-black text-emerald-950 text-center">Inscription</h2>
      <p class="text-sm text-gray-500 text-center mt-1.5 font-medium">Rejoignez DigiMarket UY1 pour commencer à acheter et vendre.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :username, "Nom d'utilisateur", class: "block text-sm font-semibold text-emerald-900 mb-1.5" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username", placeholder: "votre_pseudo", class: "w-full rounded-xl bg-gray-50/50 border border-gray-200 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-gray-900 py-3 px-4 transition-all duration-300 text-sm outline-none" %>
      </div>

      <div class="field">
        <%= f.label :email, "Adresse email", class: "block text-sm font-semibold text-emerald-900 mb-1.5" %>
        <%= f.email_field :email, autocomplete: "email", placeholder: "votre.nom@example.com", class: "w-full rounded-xl bg-gray-50/50 border border-gray-200 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-gray-900 py-3 px-4 transition-all duration-300 text-sm outline-none" %>
      </div>

      <div class="field">
        <div class="flex justify-between items-center mb-1.5">
          <%= f.label :password, "Mot de passe", class: "block text-sm font-semibold text-emerald-900" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-gray-400 font-semibold">(<%= @minimum_password_length %> caractères min.)</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "w-full rounded-xl bg-gray-50/50 border border-gray-200 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-gray-900 py-3 px-4 transition-all duration-300 text-sm outline-none" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "block text-sm font-semibold text-emerald-900 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full rounded-xl bg-gray-50/50 border border-gray-200 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-gray-900 py-3 px-4 transition-all duration-300 text-sm outline-none" %>
      </div>

      <div class="actions pt-2">
        <%= f.submit "Créer mon compte", class: "bg-gradient-to-r from-emerald-600 to-green-500 hover:from-emerald-700 hover:to-green-600 w-full py-3.5 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/10 hover:shadow-emerald-600/25 transition-all duration-300 transform active:scale-[0.98] cursor-pointer text-sm" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col items-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>