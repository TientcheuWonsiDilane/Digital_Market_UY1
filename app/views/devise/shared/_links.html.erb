<div class="flex flex-col items-center gap-2 text-sm">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Vous avez déjà un compte ? Connectez-vous", new_session_path(resource_name), class: "text-emerald-600 hover:text-emerald-800 font-semibold transition-colors" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Nouveau ici ? Créez un compte", new_registration_path(resource_name), class: "text-emerald-600 hover:text-emerald-800 font-semibold transition-colors" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), class: "text-emerald-600 hover:text-emerald-800 font-semibold transition-colors" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Vous n'avez pas reçu les instructions de confirmation ?", new_confirmation_path(resource_name), class: "text-emerald-600 hover:text-emerald-800 font-semibold transition-colors" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Vous n'avez pas reçu les instructions de déverrouillage ?", new_unlock_path(resource_name), class: "text-emerald-600 hover:text-emerald-800 font-semibold transition-colors" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Se connecter avec #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "text-sm font-bold px-6 py-2.5 rounded-full border border-gray-200 text-gray-700 hover:bg-gray-50 transition-all" %>
    <% end %>
  <% end %>
</div>
