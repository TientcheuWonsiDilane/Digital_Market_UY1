<% content_for :title, @store.name %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Store Header Card -->
  <div class="bg-white rounded-3xl border border-emerald-100 overflow-hidden shadow-sm mb-8">
    <div class="h-48 md:h-64 bg-gradient-to-br from-emerald-100 via-green-50 to-emerald-50 relative overflow-hidden">
      <% if @store.logo.attached? %>
        <%= image_tag url_for(@store.logo), class: "w-full h-full object-cover" %>
      <% else %>
        <div class="w-full h-full flex items-center justify-center">
          <span class="text-8xl md:text-9xl font-black text-emerald-300/40"><%= @store.name.first.upcase %></span>
        </div>
      <% end %>
      <div class="absolute inset-0 bg-gradient-to-t from-emerald-900/70 via-transparent to-transparent"></div>
    </div>

    <div class="px-6 pb-6 md:px-10 md:pb-8 -mt-16 relative z-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div class="flex items-end gap-4">
          <% if @store.logo.attached? %>
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl overflow-hidden border-4 border-white shadow-lg flex-shrink-0">
              <%= image_tag url_for(@store.logo), class: "w-full h-full object-cover" %>
            </div>
          <% else %>
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gradient-to-br from-emerald-500 to-green-400 border-4 border-white shadow-lg flex items-center justify-center flex-shrink-0">
              <span class="text-3xl md:text-4xl font-black text-white"><%= @store.name.first.upcase %></span>
            </div>
          <% end %>
          <div class="pb-1">
            <h1 class="text-2xl md:text-3xl font-black text-white drop-shadow-lg"><%= @store.name %></h1>
            <p class="text-sm text-emerald-100 font-medium flex items-center gap-1.5 mt-0.5">
              <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
              <%= @store.user.username %>
            </p>
          </div>
        </div>

        <div class="flex gap-3">
          <% if @can_connect %>
            <%= button_to connect_store_path(@store), method: :post, class: "inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-green-500 text-white font-bold px-6 py-3 rounded-full shadow-md hover:shadow-lg hover:from-emerald-700 hover:to-green-600 transition-all duration-300 text-sm" do %>
              <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              Connect
            <% end %>
          <% end %>
          <% if user_signed_in? && @store.user == current_user %>
            <%= link_to edit_store_path(@store), class: "inline-flex items-center gap-2 bg-white/90 text-emerald-700 font-bold px-6 py-3 rounded-full shadow-md hover:bg-white transition-all duration-300 text-sm border border-emerald-200" do %>
              <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
              </svg>
              Edit
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="px-6 md:px-10 pb-6 md:pb-8">
      <div class="prose prose-sm max-w-none text-gray-600">
        <%= @store.description.presence || "Aucune description pour cette boutique." %>
      </div>
    </div>
  </div>

  <!-- Store Items -->
  <div>
    <h2 class="text-2xl font-black text-emerald-900 mb-6 flex items-center gap-2">
      <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-emerald-600">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
      </svg>
      Produits (<%= @items.count %>)
    </h2>

    <% if @items.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @items.each do |item| %>
          <%= link_to item, class: "group bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-lg hover:border-emerald-300 transition-all duration-300" do %>
            <div class="h-48 bg-gray-100 overflow-hidden">
              <% if item.images.attached? %>
                <%= image_tag url_for(item.images.first), class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-12 h-12 text-gray-300">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="p-4">
              <h3 class="font-bold text-emerald-900 group-hover:text-emerald-700 truncate"><%= item.name %></h3>
              <p class="text-lg font-black text-emerald-600 mt-1"><%= number_to_currency(item.price, unit: "FCFA ", precision: 0) %></p>
              <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100">
                <span class="text-xs bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full"><%= item.category %></span>
                <span class="text-xs text-gray-400"><%= time_ago_in_words(item.created_at) %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center">
          <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-emerald-300">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
          </svg>
        </div>
        <p class="text-gray-500 font-semibold">Cette boutique n'a pas encore de produits.</p>
      </div>
    <% end %>
  </div>
</div>
