<%= form_with(model: store, class: "space-y-6 max-w-2xl") do |form| %>
  <% if store.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border border-red-200 text-red-600 px-5 py-4 font-medium rounded-2xl mb-6">
      <h2 class="font-bold mb-2"><%= pluralize(store.errors.count, "error") %> prohibited this store from being saved:</h2>
      <ul class="list-disc ml-6 text-sm">
        <% store.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Store Name", class: "block text-sm font-bold text-emerald-900 mb-1.5" %>
    <%= form.text_field :name, placeholder: "e.g. John's Tech Shop", class: "w-full rounded-xl border border-gray-200 px-4 py-3.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all duration-300 #{store.errors[:name].any? ? 'border-red-400' : ''}" %>
  </div>

  <div>
    <%= form.label :description, "Description", class: "block text-sm font-bold text-emerald-900 mb-1.5" %>
    <%= form.textarea :description, rows: 4, placeholder: "Describe what you sell...", class: "w-full rounded-xl border border-gray-200 px-4 py-3.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all duration-300 resize-y #{store.errors[:description].any? ? 'border-red-400' : ''}" %>
  </div>

  <div>
    <%= form.label :logo, "Store Logo", class: "block text-sm font-bold text-emerald-900 mb-1.5" %>
    <%= form.file_field :logo, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-emerald-50 file:text-emerald-700 file:font-bold hover:file:bg-emerald-100 transition-all duration-300 cursor-pointer #{store.errors[:logo].any? ? 'border-red-400' : ''}" %>
    <p class="text-xs text-gray-400 mt-1.5">Optional. Recommended: square image, max 2MB.</p>
  </div>

  <div class="flex gap-3 pt-2">
    <%= form.submit class: "bg-gradient-to-r from-emerald-600 to-green-500 hover:from-emerald-700 hover:to-green-600 text-white font-bold px-8 py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer text-sm" %>
    <%= link_to "Cancel", store.persisted? ? store_path(store) : stores_path, class: "text-sm font-bold text-gray-500 hover:text-gray-700 px-8 py-3.5 border border-gray-200 rounded-full hover:bg-gray-50 transition-all duration-300 text-center" %>
  </div>
<% end %>
