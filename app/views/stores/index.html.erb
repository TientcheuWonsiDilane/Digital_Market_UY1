<% content_for :title, "Stores" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-black text-emerald-900">Stores</h1>
      <p class="text-sm text-gray-500 mt-1">Découvrez les boutiques des étudiants et vendeurs du campus.</p>
    </div>
    <% if user_signed_in? && !current_user.has_store? %>
      <%= link_to new_store_path, class: "inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-green-500 text-white font-bold px-6 py-3 rounded-full shadow-md hover:shadow-lg transition-all duration-300" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Créer ma boutique
      <% end %>
    <% end %>
  </div>

  <!-- Search Bar -->
  <div class="mb-8">
    <%= form_with url: stores_path, method: :get, class: "relative max-w-2xl", data: { turbo_action: "replace" } do |f| %>
      <div class="relative">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <%= f.search_field :search, value: params[:search], placeholder: "Rechercher une boutique par nom ou description...", class: "w-full pl-12 pr-4 py-3.5 rounded-2xl border border-gray-200 bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all duration-300 text-sm" %>
        <% if params[:search].present? %>
          <%= link_to stores_path, class: "absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Stores Grid -->
  <% if @stores.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @stores.each do |store| %>
        <%= link_to store, class: "group bg-white rounded-2xl border border-emerald-100 overflow-hidden shadow-sm hover:shadow-lg hover:border-emerald-300 transition-all duration-300" do %>
          <div class="h-40 bg-gradient-to-br from-emerald-100 via-green-50 to-emerald-50 relative overflow-hidden">
            <% if store.logo.attached? %>
              <%= image_tag store.logo, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center">
                <span class="text-6xl font-black text-emerald-300/60"><%= store.name.first.upcase %></span>
              </div>
            <% end %>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-emerald-900/60 to-transparent h-20"></div>
          </div>
          <div class="p-5">
            <h3 class="font-bold text-lg text-emerald-900 group-hover:text-emerald-700 transition-colors truncate"><%= store.name %></h3>
            <p class="text-sm text-gray-500 mt-1 line-clamp-2"><%= store.description&.truncate(80) || "Aucune description" %></p>
            <div class="flex items-center justify-between mt-4 pt-3 border-t border-gray-100">
              <span class="text-xs text-gray-400 font-medium">
                <%= store.items.count %> produit<%= store.items.count > 1 ? 's' : '' %>
              </span>
              <span class="text-xs font-bold text-emerald-600 group-hover:translate-x-1 transition-transform">
                Visiter →
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20">
      <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-emerald-300">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-emerald-900 mb-2">Aucune boutique trouvée</h3>
      <p class="text-gray-500"><%= params[:search].present? ? 'Essayez une autre recherche.' : 'Soyez le premier à créer une boutique !' %></p>
    </div>
  <% end %>
</div>
